{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Logix Structured Text",
  "scopeName": "source.logix-st",
  "patterns": [
    { "include": "#metadata" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#calls" },
    { "include": "#operators" },
    { "include": "#tags" }
  ],
  "repository": {
    "metadata": {
      "match": "^\\s*(//)\\s*(@\\w+)\\s?(.*)$",
      "captures": {
        "1": { "name": "comment.line.double-slash.logix-st" },
        "2": { "name": "keyword.other.metadata.logix-st" },
        "3": { "name": "string.unquoted.metadata.logix-st" }
      }
    },
    "comments": {
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash.logix-st" },
        { "begin": "\\(\\*", "end": "\\*\\)", "name": "comment.block.logix-st" },
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.logix-st" }
      ]
    },
    "strings": {
      "match": "'(?:[^'$]|\\$.)*'",
      "name": "string.quoted.single.logix-st"
    },
    "keywords": {
      "patterns": [
        { "match": "(?i)\\b(IF|THEN|ELSIF|ELSE|END_IF|CASE|OF|END_CASE|FOR|TO|BY|DO|END_FOR|WHILE|END_WHILE|REPEAT|UNTIL|END_REPEAT|EXIT|RETURN)\\b", "name": "keyword.control.logix-st" },
        { "match": "(?i)\\b(AND|OR|XOR|NOT|MOD)\\b", "name": "keyword.operator.word.logix-st" },
        { "match": "(?i)\\b(TRUE|FALSE)\\b", "name": "constant.language.boolean.logix-st" }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b(16#[0-9A-Fa-f_]+|8#[0-7_]+|2#[01_]+)\\b", "name": "constant.numeric.radix.logix-st" },
        { "match": "\\b\\d+(\\.\\d+)?([eE][-+]?\\d+)?\\b", "name": "constant.numeric.logix-st" }
      ]
    },
    "calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.logix-st" } }
    },
    "operators": {
      "match": ":=|<=|>=|<>|\\*\\*|[-+*/=<>&]",
      "name": "keyword.operator.logix-st"
    },
    "tags": {
      "match": "\\\\?[A-Za-z_][A-Za-z0-9_]*(:[A-Za-z0-9_]+)*",
      "name": "variable.other.tag.logix-st"
    }
  }
}
